# nisse connector keys. ALL OPTIONAL: tier 1 (the wiki loop on pasted or local
# sources) needs none of these. Copy to .env (gitignored) and fill in only what
# you wire. Canonical human-readable connector list: operations.md, Connectors.
# Storage rules (canonical store, propagation, never hand-copy):
# governance/secrets.md. Prefer ~/.secrets/shared.env for account-wide keys;
# this file is the last-resort fallback the repo scripts read.

# Fireflies: pull meeting transcripts straight into wiki ingest.
# Get a key at app.fireflies.ai -> Integrations -> Fireflies API.
#FIREFLIES_API_KEY=

# AssemblyAI: re-transcribe garbled captures.
# Get a key at assemblyai.com.
#ASSEMBLYAI_API_KEY=

# Linear: daily ticket-tracker drift sweep (governance/ticket-tracker.md,
# scripts/ticket_tracker.py). Personal API key, user scope. Also set
# NISSE_TRACKER_DRIFT=1 to enable the hygiene tracker checks.
#LINEAR_API_KEY=
# The board/project name(s) to track, comma-separated if more than one.
# Required for scripts/ticket_tracker.py to fetch anything.
#TICKET_TRACKER_PROJECTS=
# Your tracker's issue-ID prefix (the "PROJ" in "PROJ-123"). Default "PROJ"
# if unset, which is almost certainly wrong for your workspace.
#TICKET_TRACKER_KEY_PREFIX=
# Your tracker account email; only used by the "unaddressed owner comment"
# check. Leave unset to skip that one check.
#TICKET_TRACKER_OWNER_EMAIL=

# OpenRouter: only needed if you wire the tier-3 model-routing spine
# (governance/routing.md, scripts/litellm/).
#OPENROUTER_API_KEY=
#LITELLM_MASTER_KEY=
