# secrets never enter git; see docs/confidentiality.md
.env
.env.local

.DS_Store
*.log
__pycache__/
node_modules/
.claude/settings.local.json

# harness runtime state (hook markers, locks)
.claude/state/

# transient wiki-ledger write files
wiki/metadata/*.jsonl.tmp

# scratch and one-off files
.tmp/

# verbatim meeting transcripts stay local-only; see docs/confidentiality.md
wiki/raw/transcripts/*
!wiki/raw/transcripts/.gitkeep
# the one shipped FAKE example transcript (delete with the example pages)
!wiki/raw/transcripts/2026-01-05_example_weekly_sync.md

# knowledge-graph artifacts are generated, never committed
/graphify-out
.claude/worktrees/
