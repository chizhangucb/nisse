#!/usr/bin/env bash
# managed-by: nisse-push-guard
#
# Pre-push secret + confidential-marker guard (ADR-0001). A push whose commits
# contain a secret or a `CONFIDENTIAL` marker file is rejected locally. No
# daemon, no approval step.
#
# Installed only into repos whose origin is a public (or internal) GitHub
# remote, by scripts/guards/install_push_guard.py. Because the hook lives only
# in repos others can read, both checks always enforce; there is no per-push
# visibility probe and no network call. A repo that flips public->private is
# handled by re-running the installer, which removes the hook. The installer
# copies this file into <repo>/.git/hooks/pre-push.
#
# Bypass is git's own: `git push --no-verify` skips all pre-push hooks.

set -euo pipefail

ZERO="0000000000000000000000000000000000000000"
repo_root=$(git rev-parse --show-toplevel)
fail=0

# A missing scanner fails closed: no push rather than a silently-skipped scan.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "push-guard: gitleaks not installed; refusing to push (fail-closed)." >&2
  echo "  fix: brew install gitleaks" >&2
  exit 1
fi

# stdin: <local_ref> <local_sha> <remote_ref> <remote_sha>, one line per ref.
while read -r local_ref local_sha _remote_ref remote_sha; do
  # Branch deletion: nothing to scan.
  [ "$local_sha" = "$ZERO" ] && continue

  # The commits this push would add to the remote. When the remote sha is zero
  # (new branch) or not present locally (remote advanced without a fetch),
  # fall back to "everything not already on a remote-tracking ref".
  if [ "$remote_sha" = "$ZERO" ] || ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi

  # 1) Secret scan over the pushed commit range.
  if ! gitleaks git --no-banner --log-opts="$range" "$repo_root"; then
    echo "push-guard: secret detected in $local_ref; push rejected." >&2
    fail=1
  fi

  # 2) CONFIDENTIAL marker touched anywhere in the pushed range. A marker means
  # a confidential folder; it must never reach a public remote. Scanning the
  # range (not just the tip tree) catches a marker added then deleted in-range,
  # and does not perma-block on a marker from an already-pushed commit.
  # shellcheck disable=SC2086  # $range is a controlled multi-token rev spec
  markers=$(git log --name-only --pretty=format: $range 2>/dev/null \
              | grep -E '(^|/)CONFIDENTIAL$' | sort -u || true)
  if [ -n "$markers" ]; then
    echo "push-guard: CONFIDENTIAL marker in $local_ref; push rejected." >&2
    printf '%s\n' "$markers" | sed 's/^/  /' >&2
    fail=1
  fi
done

exit "$fail"
