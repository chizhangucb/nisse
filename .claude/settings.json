{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${AIOS_HUB:-$HOME/chizhang-2}/.claude/hooks/branch-guard.py\" check 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Branch guard: checking commit branch"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-ledger.py\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Updating session ledger"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/decision-log.py\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Consolidating decision log"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-close-spawn.py\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Spawning session-close sweeper"
          },
          {
            "type": "command",
            "command": "python3 \"${AIOS_HUB:-$HOME/chizhang-2}/.claude/hooks/branch-guard.py\" pin 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Branch guard: pinning session branch"
          },
          {
            "type": "command",
            "command": "python3 \"${AIOS_HUB:-$HOME/chizhang-2}/.claude/hooks/worktree-nudge.py\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Worktree nudge: checking tree contention"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-close-marker.py\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Marking session done"
          }
        ]
      }
    ]
  }
}
